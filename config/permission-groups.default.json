{
  "core": {
    "alwaysAllow": ["ToolSearch"],
    "alwaysAllowBashPatterns": [
      "^cat \"\\$OUTPOST_ENVELOPE\"$",
      "^cat ",
      "^jq "
    ],
    "alwaysAllowMcpPatterns": [
      "^mcp__outpost__"
    ],
    "alwaysAllowPathPatterns": []
  },
  "read": {
    "alwaysAllow": ["Read", "Glob", "Grep", "LS", "NotebookRead"],
    "alwaysAllowBashPatterns": [
      "^(ls|head|tail|file|wc|stat|du|pwd|whoami|date|printenv|which|type|echo|printf|tree|sort|uniq|cut|comm|diff|cmp|column|basename|dirname|realpath|nl|xxd|od)(\\s|$)",
      "^git (-C [^-\\s]\\S* )?(status|log|diff|show|blame|branch|remote -v|remote get-url|config --get|fetch|rev-parse|ls-files|ls-tree|cat-file|describe|shortlog|show-ref|grep|tag -l|stash list|worktree list)(\\s|$)",
      "^(rg|grep)(\\s|$)",
      "^find(\\s|$)"
    ],
    "alwaysAllowMcpPatterns": [],
    "alwaysAllowPathPatterns": []
  },
  "pull": {
    "alwaysAllow": ["WebFetch", "WebSearch", "ListMcpResourcesTool", "ReadMcpResourceTool"],
    "alwaysAllowBashPatterns": [
      "^curl(?:(?:\\s|\\\\\\n)+(?:-[fsSL]+|--(?:silent|fail|show-error|location|compressed)|(?:--max-time|--connect-timeout|-H|--header)(?:(?:\\s|\\\\\\n)+|=)(?:\"[^-\"\\n][^\"\\n]*\"|'[^-'\\n][^'\\n]*'|[A-Za-z0-9_$./][^\\s\"'<>&|;\\\\]*)|[\"']?(?:https?://|\\$\\{?[A-Za-z_])[^\\s\"'<>&|;\\\\]*[\"']?))*(?:\\s|\\\\\\n)*$",
      "^gh api(?:(?:\\s|\\\\\\n)+(?:--paginate|--slurp|(?:--cache|--hostname|-H|--header|-q|--jq|-t|--template)(?:(?:\\s|\\\\\\n)+|=)(?:\"[^-\"\\n][^\"\\n]*\"|'[^-'\\n][^'\\n]*'|[A-Za-z0-9_$./][^\\s\"'<>&|;\\\\]*)|(?:--method|-X)(?:(?:\\s|\\\\\\n)+|=)GET|(?:\"[^-\"\\n][^\"\\n]*\"|'[^-'\\n][^'\\n]*'|[A-Za-z0-9_$./][^\\s\"'<>&|;\\\\]*)))*(?:\\s|\\\\\\n)*$",
      "^gh (pr view|pr list|pr checks|pr diff|pr status|run view|run list|run watch|workflow view|workflow list|repo view|issue view|issue list|search|release view|release list|label list|cache list|browse)(\\s|$)"
    ],
    "alwaysAllowMcpPatterns": [
      "^mcp__claude_ai_Linear__(get_|list_|search_)",
      "^mcp__claude_ai_DataDog_MCP__(search_|analyze_|find_|list_|load_|get_|aggregate_)",
      "^mcp__github__(get|list|search|pull_request_read|issue_read)",
      "^mcp__notion__notion-(fetch|search|get-)",
      "^mcp__claude_ai_Slack__slack_(read_|search_)",
      "^mcp__incident-io__(.*_show|.*_list|alert_stats|incident_stats|follow_up_stats|escalation_stats|ask|ask_incident|ask_telemetry|investigation_sync)$",
      "^mcp__grafana__(get_|list_|search_|query_|find_|analyze_)"
    ],
    "alwaysAllowPathPatterns": []
  },
  "edit": {
    "alwaysAllow": [],
    "alwaysAllowBashPatterns": [
      "^mage(\\s|$)",
      "^npm (test|run|install|ci)(\\s|$)",
      "^(yarn|pnpm)(\\s|$)",
      "^npx(\\s|$)",
      "^(tsx|node|tsc|vitest|jest|playwright|eslint|prettier)(\\s|$)",
      "^go(\\s|$)",
      "^(golangci-lint|gofmt|goimports)(\\s|$)",
      "^pytest(\\s|$)",
      "^(ruff|black)(\\s|$)",
      "^cargo (build|test|check|clippy|fmt)(\\s|$)",
      "^make(\\s|$)",
      "^(mkdir|mv|cp|touch|rm|rmdir|ln|chmod)(\\s|$)",
      "^git (-C [^-\\s]\\S* )?(rebase|checkout|merge|stash|add|reset|restore|cherry-pick|revert|clean|switch|apply|mv|rm)(\\s|$)"
    ],
    "alwaysAllowMcpPatterns": [],
    "alwaysAllowPathPatterns": [
      "Edit:^/tmp/",
      "Write:^/tmp/",
      "MultiEdit:^/tmp/"
    ]
  },
  "push": {
    "alwaysAllow": [],
    "alwaysAllowBashPatterns": [
      "^git push(?:[ \\t]+(?:-u|--set-upstream|-q|--quiet|--porcelain))*(?:[ \\t]+[\"']?[A-Za-z][A-Za-z0-9._-]*[\"']?(?:[ \\t]+(?![\"']?(?:main|master|trunk|develop|dev|release[/-][^\\s\"']*|(?:refs/)?heads/[^\\s\"']*)[\"']?[ \\t]*$)[\"']?(?:HEAD|[A-Za-z0-9_][A-Za-z0-9._/-]*)[\"']?)?)?[ \\t]*$",
      "^git commit(?:[ \\t]+(?:-a|-n|-s|-q|--all|--no-verify|--signoff|--quiet|--allow-empty|--no-edit|--no-gpg-sign|(?:-m|-am|-an|-as|--message)(?:[ \\t]+|=)(?:\"[^\"$`\\n]*\"|'[^'\\n]*'|[A-Za-z0-9_./][^\\s\"'$`\\n]*)))*[ \\t]*$",
      "^git tag(?:[ \\t]+(?:-a|-s|--annotate|(?:-m|--message)(?:[ \\t]+|=)(?:\"[^\"$`\\n]*\"|'[^'\\n]*'|[A-Za-z0-9_./][^\\s\"'$`\\n]*)))*[ \\t]+(?:\"[A-Za-z0-9_][^\"$`\\n]*\"|'[A-Za-z0-9_][^'\\n]*'|[A-Za-z0-9_][^\\s\"'$`\\n]*)(?:[ \\t]+(?:\"[A-Za-z0-9_][^\"$`\\n]*\"|'[A-Za-z0-9_][^'\\n]*'|[A-Za-z0-9_][^\\s\"'$`\\n]*))?[ \\t]*$",
      "^gh pr comment[ \\t]+[0-9]+[ \\t]+(?:--(?:body)(?:[ \\t]+|=)(?:\"[^\"$`\\n]*\"|'[^'\\n]*'|[A-Za-z0-9_./][^\\s\"'$`\\n]*)|--body-file(?:[ \\t]+|=)[\"']?/tmp/[A-Za-z0-9_][A-Za-z0-9._/-]*[\"']?)[ \\t]*$",
      "^gh pr merge[ \\t]+[0-9]+[ \\t]+(?:--squash|--merge|--rebase)(?:[ \\t]+(?:--auto|--(?:subject|body)(?:[ \\t]+|=)(?:\"[^\"$`\\n]*\"|'[^'\\n]*'|[A-Za-z0-9_./][^\\s\"'$`\\n]*)|--body-file(?:[ \\t]+|=)[\"']?/tmp/[A-Za-z0-9_][A-Za-z0-9._/-]*[\"']?))*[ \\t]*$",
      "^gh pr review[ \\t]+[0-9]+[ \\t]+(?:--approve|--request-changes|--comment)(?:[ \\t]+(?:--(?:body)(?:[ \\t]+|=)(?:\"[^\"$`\\n]*\"|'[^'\\n]*'|[A-Za-z0-9_./][^\\s\"'$`\\n]*)|--body-file(?:[ \\t]+|=)[\"']?/tmp/[A-Za-z0-9_][A-Za-z0-9._/-]*[\"']?))?[ \\t]*$",
      "^gh pr create(?:[ \\t]+(?:--draft|--fill|--fill-verbose|--(?:title|body|base|head|assignee|reviewer|label|milestone)(?:[ \\t]+|=)(?:\"[^\"$`\\n]*\"|'[^'\\n]*'|[A-Za-z0-9_./][^\\s\"'$`\\n]*)|--body-file(?:[ \\t]+|=)[\"']?/tmp/[A-Za-z0-9_][A-Za-z0-9._/-]*[\"']?))*[ \\t]*$",
      "^gh pr edit[ \\t]+[0-9]+(?:[ \\t]+(?:--(?:title|body|base|add-label|remove-label|add-reviewer|add-assignee|milestone)(?:[ \\t]+|=)(?:\"[^\"$`\\n]*\"|'[^'\\n]*'|[A-Za-z0-9_./][^\\s\"'$`\\n]*)|--body-file(?:[ \\t]+|=)[\"']?/tmp/[A-Za-z0-9_][A-Za-z0-9._/-]*[\"']?))*[ \\t]*$",
      "^gh pr ready[ \\t]+[0-9]+(?:[ \\t]+--undo)?[ \\t]*$",
      "^gh pr close[ \\t]+[0-9]+(?:[ \\t]+--(?:comment)(?:[ \\t]+|=)(?:\"[^\"$`\\n]*\"|'[^'\\n]*'|[A-Za-z0-9_./][^\\s\"'$`\\n]*))?[ \\t]*$",
      "^gh issue create(?:[ \\t]+(?:--(?:title|body|label|assignee|milestone|project)(?:[ \\t]+|=)(?:\"[^\"$`\\n]*\"|'[^'\\n]*'|[A-Za-z0-9_./][^\\s\"'$`\\n]*)|--body-file(?:[ \\t]+|=)[\"']?/tmp/[A-Za-z0-9_][A-Za-z0-9._/-]*[\"']?))*[ \\t]*$",
      "^gh issue comment[ \\t]+[0-9]+[ \\t]+(?:--(?:body)(?:[ \\t]+|=)(?:\"[^\"$`\\n]*\"|'[^'\\n]*'|[A-Za-z0-9_./][^\\s\"'$`\\n]*)|--body-file(?:[ \\t]+|=)[\"']?/tmp/[A-Za-z0-9_][A-Za-z0-9._/-]*[\"']?)[ \\t]*$",
      "^gh issue close[ \\t]+[0-9]+(?:[ \\t]+--(?:comment|reason)(?:[ \\t]+|=)(?:\"[^\"$`\\n]*\"|'[^'\\n]*'|[A-Za-z0-9_./][^\\s\"'$`\\n]*))*[ \\t]*$",
      "^gh release create[ \\t]+(?:\"[A-Za-z0-9_][^\"$`\\n]*\"|'[A-Za-z0-9_][^'\\n]*'|[A-Za-z0-9_][^\\s\"'$`\\n]*)(?:[ \\t]+(?:--draft|--prerelease|--generate-notes|--latest|--(?:title|notes|target)(?:[ \\t]+|=)(?:\"[^\"$`\\n]*\"|'[^'\\n]*'|[A-Za-z0-9_./][^\\s\"'$`\\n]*)|--notes-file(?:[ \\t]+|=)[\"']?/tmp/[A-Za-z0-9_][A-Za-z0-9._/-]*[\"']?))*[ \\t]*$"
    ],
    "alwaysAllowMcpPatterns": [
      "^mcp__claude_ai_Linear__(save_|create_)",
      "^mcp__github__(?:create_branch|create_pull_request|update_pull_request|update_pull_request_branch|add_issue_comment|add_comment_to_pending_review|add_reply_to_pull_request_comment|request_copilot_review)$",
      "^mcp__claude_ai_Slack__slack_(send_|schedule_|create_|update_)",
      "^mcp__notion__notion-(create-|update-|move-|duplicate-)"
    ],
    "alwaysAllowPathPatterns": []
  }
}
