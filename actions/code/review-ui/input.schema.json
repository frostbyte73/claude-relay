{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "code.review-ui input",
  "type": "object",
  "required": ["workspace"],
  "properties": {
    "workspace": {
      "type": "object",
      "required": ["repoCwd", "branch"],
      "properties": {
        "repoCwd": { "type": "string" },
        "branch": { "type": "string" }
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "goal": { "type": "string" },
        "approach": { "type": "string" },
        "risks": { "type": "string" }
      }
    },
    "diffRange": {
      "type": "string",
      "description": "Optional git diff range to review instead of the uncommitted working-tree diff, e.g. \"<merge-base>...<head>\" (three-dot form). Omit to review the uncommitted diff as before."
    }
  },
  "additionalProperties": false
}
