{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "code.implement input",
  "description": "The orchestrated step envelope as code.implement sees it, on a turn where boundAction is code.implement.",
  "type": "object",
  "required": [
    "jobId",
    "stepId",
    "goal",
    "workspace"
  ],
  "properties": {
    "jobId": {
      "type": "string"
    },
    "stepId": {
      "type": "string"
    },
    "type": {
      "const": "orchestrated"
    },
    "controller": {
      "const": "code.orchestrate-pr"
    },
    "goal": {
      "type": "string"
    },
    "inputs": {
      "type": "object",
      "description": "Planner-supplied inputs for the step \u2014 `approach` and `risks` for a PR step.",
      "properties": {
        "approach": {
          "type": "string"
        },
        "risks": {
          "type": "string"
        }
      }
    },
    "workspace": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "none",
            "readonly",
            "writable"
          ]
        },
        "repoCwd": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        }
      }
    },
    "phase": {
      "type": "string",
      "description": "Where the controller thinks the step stands."
    },
    "memo": {
      "type": "string",
      "description": "The controller's durable narrative from prior turns."
    },
    "artifacts": {
      "type": "object",
      "description": "`spec` and `implPlan` from the earlier rounds.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "boundAction": {
      "const": "code.implement",
      "description": "Set to this action on the turn it runs."
    },
    "boundNote": {
      "type": "string",
      "description": "What the controller asked this round to do."
    },
    "previousSteps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "output": {
            "type": "string"
          }
        }
      }
    },
    "job": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "externalRef": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    },
    "gateApproved": {
      "type": "boolean"
    },
    "gateFeedback": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recentLessons": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
