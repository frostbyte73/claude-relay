{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "code.fix-ci input",
  "type": "object",
  "required": ["jobId", "stepId", "workspace", "typePayload"],
  "properties": {
    "jobId": { "type": "string" },
    "stepId": { "type": "string" },
    "goal": { "type": "string" },
    "approach": { "type": "string" },
    "workspace": {
      "type": "object",
      "required": ["repoCwd", "branch"],
      "properties": {
        "repoCwd": { "type": "string" },
        "branch": { "type": "string" }
      }
    },
    "typePayload": {
      "type": "object",
      "required": ["round"],
      "properties": {
        "round": {
          "type": "object",
          "required": ["kind", "checks"],
          "properties": {
            "kind": { "const": "ci-fix" },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "url": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "recentLessons": { "type": "array", "items": { "type": "object" } }
  }
}
